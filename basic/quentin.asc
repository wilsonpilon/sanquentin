740 '
750 PRINT:PRINT"VOCE CARREGA :":IN=0
760 FORG=1TONB
770 IFOB(G)=-1THENPRINTTAB(14)OB$(G):IN=IN+1
780 NEXT:PRINT
790 IFIN=0THENPRINTTAB(14)"NADA!!":PRINT
800 GOTO 450
810 '
820 FORG=1TONB
830 IFINSTR(OB$(G),N$)=1THEN860
840 NEXT
850 PRINT:PRINT"NAO SEI O QUE E "N$:PRINT:GOTO 450
860 IFMA=3THENPRINT:PRINT"VOCE NAO TEM COMO CARREGAR TANTOS       OBJETOS. DEIXE UM!":PRINT:GOTO 450
870 IFOB(G)=-1THENPRINT:PRINT"VOCE JA PEGOU.":PRINT:GOTO 450
880 IF OB(G)<>LTHEN PRINT:PRINT:PRINT"NAO ESTA AQUI.":PRINT:GOTO 450
890 PRINT"OK!":PRINT:OB(G)=-1:MA=MA+1
900 GOTO 450
910 '
920 FORG=1TONB
930 IFINSTR(OB$(G),N$)=1THEN960
940 NEXT
950 PRINT:PRINT"NAO SEI O QUE E "N$:PRINT:GOTO 450
960 IFOB(G)<>-1THENPRINT:PRINT"VOCE NAO PODE "V$" O QUE NAO TEM.":PRINT:GOTO 450
970 PRINT"OK!":PRINT:OB(G)=L:MA=MA-1
980 GOTO 450
990 '
1000 CLS:PRINT:PRINTTAB(14)"PARABENS!":PRINT:PRINT"VOCE CONSEGUIU A LIBERDADE!":PRINT"AGORA PROCURE TRILHAR O CAMINHO DO BEM, POIS O CRIME (AS VEZES) NAO COMPENSA!"
1010 KEYOFF:IFI=11THENCLS:PRINTTAB(12)"QUE VERGONHA!":ENDELSEPRINT:PRINT:PRINTTAB(7)"ACEITA OUTRA FUGA (S/N)?";
1020 A$=INPUT$(1)
1030 IFA$="S"THENRUN
1040 END
1050 '
1060 IFL<>17THENPRINT:PRINT"ONDE ?":PRINT:GOTO 450
1070 IFOB(4)=-1THENPRINT:PRINT"VOCE SE AFOGOU! A SERRA QUE VOCE LEVAVA ERA MUITO PESADA.":GOTO 1010
1080 IFOB(10)<>-1THENPRINT:PRINT"VOCE ACHOU UMA MOEDA. VOLTE!":PRINT"A CORRENTEZA ESTA MUITO FORTE.":PRINT:OB(10)=-1:GOTO 450
1090 PRINT:PRINT"VOCE SE MOLHOU TODO!":PRINT:GOTO 450
1100 '
1110 IN=INSTR("LANTERNA",N$):IFIN<>1THENPRINT:PRINT"ISSO NAO ACENDE.":PRINT:GOTO 450
1120 IFOB(12)<>-1THENG=12:GOTO 960
1130 IFLA=1THENPRINT:PRINT"JA ESTA ACESA.":PRINT:GOTO 450
1140 PRINT"OK!":LA=1:GOTO 450
1150 '
1160 IFOB(11)<>-1THENPRINT:PRINT"VOCE NAO TEM O CANIVETE.":PRINT:GOTO 440
1170 IFOB(14)<>LTHENPRINT:PRINTV$" QUEM ?":PRINT:GOTO 440
1180 PRINT:PRINT"VOCE MATOU O "OB$(14):PRINT:OB(14)=0:GOTO 450
1190 '
1200 IN=0:OB(14)=0
1210 FORK=1TONB
1220 IFOB(K)=-1THENIN=IN+1
1230 NEXT
1240 IFIN=0THENPRINT:PRINT"COMO VOCE NAO TEM NADA QUE POSSA        SUBORNAR O GUARDA, ELE O PRENDE EM NOME DA LEI.":GOTO 1010
1250 IFOB(9)=-1THENPRINT:PRINT"ELE LHE VIU UNIFORMIZADO DE GUARDA E    LHE CONFUNDIU COM OUTRO GUARDA.":PRINT:GOTO 450
1260 K=INT(RND(-TIME)*NB+1):IFOB(K)<>-1THEN1260
1270 PRINT:PRINT"ELE CONFISCOU O SEGUINTE OBJETO:"OB$(K):PRINT:OB(K)=0:MA=MA-1
1280 IFK=13THENPRINT:PRINT"PROCURE OUTRA!":PRINT:GOTO 370
1290 GOTO 450
1300 '
1310 N$="":I=INSTR(I$," ")
1320 IFI=0THENV$=I$:GOTO 1350
1330 V$=LEFT$(I$,I-1)
1340 N$=MID$(I$,I+1)
1350 I=0
1360 FORK=1TO21
1370 IFINSTR(R$(K),V$)=1THENI=R(K):I$=LEFT$(V$,1)
1380 NEXT
1390 RETURN
1400 '
1410 IFL<>17OROB(4)<>-1THEN1420ELSE1440
1420 IFL=14ANDOB(12)=-1ANDLA=1THEN1450ELSE1430
1430 IFL=12ANDOB(12)<>-1THEN1460ELSE1470
1440 PRINT:PRINT"ALGUNS OBJETOS PODEM SER PESADOS!":PRINT:GOTO 450
1450 PRINT:PRINT"CERTOS OBJETOS CHAMAM MUITA ATENCAO!":PRINT:GOTO 450
1460 PRINT:PRINT"VOCE NAO DEVIA TER ENTRADO AQUI SEM A   LANTERNA! DESISTA, VOCE ESTA PERDIDO!":PRINT:GOTO 450
1470 PRINT:PRINT"DESCULPE, NAO POSSO AJUDAR AGORA!":PRINT:GOTO 450
1480 '
