                                    440 		ret								; Back to slots scanning
                                    441 
                                    442 	; Routine to execute the ROM
                                    443 	crt0_bdos_hook:
                                    444 		rst		0x30					; Inter-slot call
                                    445 		.db		1						; This byte will be replaced by the slot number of ROM
                                    446 		.dw		crt0_bdos_resume		; Address to execute the ROM
                                    447 
                                    448 	; Remove the hook and resume the ROM boot sequence
                                    449 	crt0_bdos_resume:
                                    450 		ld		a, #0xC9				; 'ret' instruction
                                    451 		ld		(H_STKE), a
                                    452 
                                    453 	crt0_bdos_end:
