                                    112 ; ISR types
                         00000000   113 ISR_NONE			= 0				; No ISR
                         00000001   114 ISR_ALL				= 1				; Handle any interruption
                         00000002   115 ISR_VBLANK			= 2				; V-blank handler (V9938 or V9958)
                         00000003   116 ISR_VHBLANK			= 3				; V-blank and h-blank handler (V9958)
                         00000004   117 ISR_V9990			= 4				; V-blank, h-blank and command end handler (V9990)
                                    118 
                                    119 ;------------------------------------------------------------------------------
                                    120 ; Install ISR in RAM; either in page 0 (with optional code/data copy there) or in page 3 to use with IM2
                         00000000   121 RAMISR_NONE			= 0				; Don't install ISR in RAM
                         00000001   122 RAMISR_PAGE0		= 1				; Install ISR in page 0
                         00000002   123 RAMISR_SEGMENT0		= 2				; Install ISR and segment data (for mapped-ROM) in page 0
                         00000003   124 RAMISR_PAGE3		= 3				; Install ISR in page 3 (to use with IM2)
                                    125 
                                    126 ;------------------------------------------------------------------------------
                                    127 ; Check for ROM boot skipping if a given key is pressed (string)
                         00000000   128 SKIP_NONE			= 0				; Don't skip the ROM boot
                         00000001   129 SKIP_ALL			= 1				; Skip the ROM boot and go directly to BASIC or MSX-DOS
                         00000002   130 SKIP_DELAY			= 2				; Skip the delay boot and start the ROM program immediately
