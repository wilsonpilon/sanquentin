                                    415 ;------------------------------------------------------------------------------
                                    416 ; Delay boot using STKE hook
                                    417 ;------------------------------------------------------------------------------
                                    418 .macro DELAY_BOOT
                                    419 	.if ROM_DELAY
                                    420 
                                    421 	.ifeq ROM_SKIP-SKIP_DELAY
                                    422 	crt0_bdos_skip:
                                    423 		in		a, (PPI_C)
                                    424 		and		#0xF0					; only change bits 0-3
                                    425 		or		#7						; check row number 7
                                    426 		out		(PPI_C), a
                                    427 		in		a, (PPI_B)				; read row into A
                                    428 		and		#ROM_SKIP_KEY
                                    429 		jp		z, crt0_bdos_end
                                    430 	.endif
                                    431 
                                    432 	; Setup the hook H.STKE to run the ROM with disk support
                                    433 	crt0_bdos_install::
                                    434 		ld		a, c					; Get the ROM slot number
                                    435 		ld		hl, #crt0_bdos_hook
                                    436 		ld		de, #H_STKE
                                    437 		ld		bc, #4
                                    438 		ldir							; Copy the routine to execute the ROM to the hook
                                    439 		ld		(H_STKE+1), a			; Put the ROM slot number to the hook
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 14
