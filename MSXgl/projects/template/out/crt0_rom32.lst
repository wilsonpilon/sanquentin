                                    759 	crt0_jump_code_start:
                                    760 		jp		0xC101
                                    761 	crt0_jump_code_end:
                                    762 
                                    763 	; ISR code to be install
                                    764 		INCLUDE_ISR
                                    765 
                                    766 	; Copy ISR to RAM
                                    767 	crt0_install_isr::
                                    768 		; Install vector table (257 bytes with 0xC1)
                                    769 		ld		hl, #0xC000
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 20
