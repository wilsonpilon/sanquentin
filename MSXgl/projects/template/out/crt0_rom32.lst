                                    460 .macro DO_CHECK_MSX
                                    461 	.ifne CHECK_MSX-MSX1
                                    462 	; Check for minimal MSX version and display message if not correct
                                    463 	crt0_check_msx::
                                    464 		ld		a, (MSXVER)
                                    465 		cp		#CHECK_MSX
                                    466 		jp		nc, crt0_check_msx_end ; Version must be equal or higher
                                    467 
                                    468 		ld		a, #40
                                    469 		ld		(LINL40), a			; Set number of columns
                                    470 		call	INITXT				; Switch to Screen 0 (text mode)
                                    471 
                                    472 		ld		hl, #crt0_check_msx_message
                                    473 		call	crt0_check_msx_print ; Display error message
                                    474 
                                    475 	crt0_check_msx_loop:
                                    476 		call	CHGET				; Waiting for user to press a key
                                    477 		cp		#67 				; Character 'C'
                                    478 		jp		z, crt0_check_msx_end
                                    479 		cp		#99 				; Character 'c'
                                    480 		jp		z, crt0_check_msx_end
                                    481 		jr		crt0_check_msx_loop
                                    482 
                                    483 	crt0_check_msx_print:
                                    484 		ld		a, (hl)
                                    485 		or		a
                                    486 		ret		z
                                    487 		call	CHPUT
                                    488 		inc		hl
                                    489 		jr		crt0_check_msx_print
                                    490 
                                    491 	crt0_check_msx_message:
                                    492 		.ascii	"Error: A "
                                    493 		.ifeq CHECK_MSX-MSX2
                                    494 		.ascii	"MSX2"
