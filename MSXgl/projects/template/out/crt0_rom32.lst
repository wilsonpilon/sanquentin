                                    165 ; Set page #2 at the same slot than the page #1 (for 32K ROM)
                                    166 ;------------------------------------------------------------------------------
                                    167 .macro INIT_P1_TO_P2
                                    168 
                                    169 	crt0_p1_to_p2::
                                    170 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                    171 		rrca
                                    172 		rrca							; A=[P0|P3|P2|P1]
                                    173 		and		a, #0b00000011			; A=[00|00|00|P1] Save Page 1 primary slot
                                    174 		ld		c, a					; C=[00|00|00|P1]
                                    175 		ld		hl, #EXPTBL				; HL=&EXPTBL
                                    176 		add		a, l
                                    177 		ld		l, a
                                    178 		ld		a, (hl)					; A=EXPTBL[P1]    See if the slot is expanded or not
                                    179 		and		a, #0x80				; A=[X|000|00|00] Keep only expansion flag
                                    180 		or		a, c					; A=[X|000|00|P1] Set MSB if so
                                    181 		ld		c, a					; C=[X|000|00|P1] Save it to [C]
                                    182 		inc		l						;                 Point to primary slot's SLTTBL entry
                                    183 		inc		l
                                    184 		inc		l
                                    185 		inc		l
                                    186 		ld		a, (hl)					; A=SLTTBL[P1]    Get what is currently output to expansion slot register
                                    187 		and		a, #0b00001100			; A=[00|00|S1|00]
                                    188 		or		c						; A=[X|000|S1|P1] Finally form slot address
                                    189 		ld		h, #0x80				; H=Page 2
                                    190 		call	ENASLT					;                 Enable page 1's slot in page 2
                                    191 .endm
                                    192 
                                    193 ;------------------------------------------------------------------------------
                                    194 ; Set pages #0 and #2 at the same slot than the page #1 (for 48K ROM)
                                    195 ;------------------------------------------------------------------------------
                                    196 .macro INIT_P1_TO_P02
                                    197 
                                    198 	; Backup Page 0 (Main-ROM) information
                                    199 	BACKUP_ROMINFO
                                    200 
                                    201 	; Call event before BIOS release
                                    202 	ON_BIOS_RELEASE
                                    203 
                                    204 	crt0_p1_to_p02::
                                    205 		; Set all pages primary slot equal to page #1 one
                                    206 		in		a, (PPI_A)				; A=[P3|P2|P1|P0] Get primary slots info
                                    207 		ld		d, a					; D=[P3|P2|P1|P0] Backup full slots info
                                    208 		and		a, #0b00001100			; A=[00|00|P1|00] Mask all pages slots but P1 
                                    209 		ld		c, a					; C=[00|00|P1|00] Backup P1
                                    210 		rrca							;                 A>>1
                                    211 		rrca							; A=[00|00|00|P1] A>>1
                                    212 		or		a, c					; A=[00|00|P1|P1]
                                    213 		ld		c, a					; C=[00|00|P1|P1] Backup 
                                    214 		add		a, a					;                 A<<1
                                    215 		add		a, a					; A=[00|P1|P1|00] A<<1
                                    216 		add		a, a					;                 A<<1
                                    217 		add		a, a					; A=[P1|P1|00|00] A<<1
                                    218 		or		a, c					; A=[P1|P1|P1|P1] Merge
                                    219 		out		(PPI_A), a				;                 Set primary slots info
ASxxxx Assembler V05.50.4+NoICE+SDCCmods-WIP-R14  (Zilog Z80 / Hitachi HD64180 / ZX-Next / eZ80 / R800)                                Page 10
Hexadecimal [32-Bits]



                                    220 		ld		e, a					; E=[P1|P1|P1|P1] Backup new slots
                                    221 
                                    222 		; Set page #0 and 2 at the same secondary slot than page #1 one
                                    223 		ld		a, (SLTSL)				; A=[~3|~2|~1|~0] Read secondary slots register of selected primary slot
                                    224 		cpl								; A=[S3|S2|S1|S0] Reverses the bits
                                    225 		ld		b, a					; B=[S3|S2|S1|S0] Backup secondary slot
                                    226 		and		a, #0b00001100			; A=[00|00|S1|00] Mask all pages secondary slots but P1 
                                    227 		ld		c, a					; C=[00|00|S1|00] Backup
                                    228 		rrca							;                 A>>1
                                    229 		rrca							; A=[00|00|00|S1] A>>1
                                    230 		or		a, c					; A=[00|00|S1|S1] Merge
                                    231 		ld		c, a					; C=[00|00|S1|S1] Backup
                                    232 		add		a, a					;                 A<<1
                                    233 		add		a, a					; A=[00|S1|S1|00] A<<1
                                    234 		or		a, c					; A=[00|S1|S1|S1] Merge
                                    235 		ld		c, a					; C=[00|S1|S1|S1] Backup
                                    236 		ld		a, b					; A=[S3|S2|S1|S0] Restore primary slots info 
                                    237 		and		a, #0b11000000			; A=[S3|00|00|00] Mask all pages slots but P0 
                                    238 		or		a, c					; A=[S3|S1|S1|S0] Merge original P0 and P1 in all other page
                                    239 		ld		(SLTSL), a				;                 Set secondary slot info
                                    240 
                                    241 		; Restore initial Page 3 slot
                                    242 		ld		a, d					; A=[P3|P2|P1|P0] Restore initiale primary slots
                                    243 		and		a, #0b11000000			; A=[P3|00|00|00] Keep page #3 primary slot
                                    244 		ld		c, a					; C=[P3|00|00|00] Backup
                                    245 		ld		a, e					; A=[P1|P1|P1|P1] Restore new primary slots
                                    246 		and		a, #0b00111111			; A=[00|P1|P1|P1] Keep all pages but page #3
                                    247 		or		a, c					; A=[P3|P1|P1|P1] Merge
                                    248 		out		(PPI_A), a				;                 Set primary slots info
                                    249 .endm
