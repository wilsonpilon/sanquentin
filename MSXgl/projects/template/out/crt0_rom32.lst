                                     14 	; Setup the hook H.STKE to run the ROM with disk support
                                     15 	crt0_bdos_install::
                                     16 		ld		a, c					; Get the ROM slot number
                                     17 		ld		hl, #crt0_bdos_hook
                                     18 		ld		de, #H_STKE
                                     19 		ld		bc, #4
                                     20 		ldir							; Copy the routine to execute the ROM to the hook
                                     21 		ld		(H_STKE+1), a			; Put the ROM slot number to the hook
                                     22 		ret								; Back to slots scanning
                                     23 
                                     24 	; Routine to execute the ROM
                                     25 	crt0_bdos_hook:
                                     26 		rst		0x30					; Inter-slot call
                                     27 		.db		1						; This byte will be replaced by the slot number of ROM
                                     28 		.dw		crt0_bdos_resume		; Address to execute the ROM
                                     29 
                                     30 	; Remove the hook and resume the ROM boot sequence
                                     31 	crt0_bdos_resume:
                                     32 		ld		a, #0xC9				; 'ret' instruction
                                     33 		ld		(H_STKE), a
                                     34 
